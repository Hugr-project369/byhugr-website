# Cloudflare Pages response headers for the hugr site.
# The privacy policy says the site loads no third-party content.
# The Content-Security-Policy below makes the browser enforce that, not just trust it.
#
# connect-src lists both Google hosts on purpose: the Apps Script /exec URL
# answers with a redirect to script.googleusercontent.com, so the waitlist post
# needs both. Nothing else is allowed out.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://script.google.com https://script.googleusercontent.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
